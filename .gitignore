# .windsurf/ (Cerveau)
#.windsurf/
#! .windsurf/settings.json
#! .windsurf/cascade/
#! .windsurf/memory/
#! .windsurf/mcp/

# Memory DB (Locally stored databases)
memory-database/cache/*.db
memory-database/graph/*.db
memory-database/vector/qdrant/
memory-database/vector/zvec/

# Environments and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Standard exclusions
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# VS Code specific
.vscode/*
! .vscode/settings.json
! .vscode/tasks.json
! .vscode/launch.json
! .vscode/extensions.json
.history/
*.vsix

# Logs and runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS specific
.DS_Store
Thumbs.db
